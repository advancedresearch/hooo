
fn nn_tauto_excm_n_to_tauto_nn : !!a & excm(!a)^true -> (!!a)^true {
    use hooo_tauto_or;
    use refl;

    x : !!a;
    y : excm(!a)^true;

    let y2 = hooo_tauto_or(y) : (!a)^true | (!!a)^true;
    lam f1 : (!a)^true => (!!a)^true {
        use absurd;
        use triv;

        y : (!a)^true;

        let y2 = triv(y) : !a;
        let y3 = x(y2) : false;
        let r = absurd(y3) : (!!a)^true;
        return r;
    }
    let f2 = refl() : (!!a)^true => (!!a)^true;
    let r = match y2 (f1, f2) : (!!a)^true;
    return r;
}

fn not_tauto_excm_n_to_tauto_not : !a & excm(!a)^true -> (!a)^true {
    use nn_tauto_excm_n_to_tauto_nn;
    use not_double;
    use pow_transitivity;
    use not_rev_triple;
    use excm_n_to_excm_nn;

    x : !a;
    y : excm(!a)^true;

    let y2 = pow_transitivity(y, excm_n_to_excm_nn) : excm(!!a)^true;
    let x2 = not_double(x) : !!!a;
    let x3 = nn_tauto_excm_n_to_tauto_nn(x2, y2) : (!!!a)^true;
    let r = pow_transitivity(x3, not_rev_triple) : (!a)^true;
    return r;
}

fn not_tauto_excm_n_to_para : !a & excm(!a)^true -> false^a {
    use not_tauto_excm_n_to_tauto_not;
    use tauto_not_to_para;

    x : !a;
    y : excm(!a)^true;

    let x2 = not_tauto_excm_n_to_tauto_not(x, y) : (!a)^true;
    let r = tauto_not_to_para(x2) : false^a;
    return r;
}
