name: "struct_analysis";
version: "0.1.0";
description: "add your description here";
functions {
  associative : associative';
  associative_from : sym(p, all(p'(p'(a, b), c) == p'(a, p'(b, c))))(p) -> associative'(p);
  associative_prop_and : true -> associative'(prop_and');
  associative_prop_eq_excm : Excm' -> associative'(prop_eq');
  associative_prop_or : true -> associative'(prop_or');
  associative_to : associative'(p) -> sym(p, all(p'(p'(a, b), c) == p'(a, p'(b, c))))(p);
  commutative : commutative';
  commutative_from : sym(p, all(p'(a, b) == p'(b, a)))(p) -> commutative'(p);
  commutative_prop_and : true -> commutative'(prop_and');
  commutative_prop_eq : true -> commutative'(prop_eq');
  commutative_prop_or : true -> commutative'(prop_or');
  commutative_q : true -> commutative'(q');
  commutative_to : commutative'(p) -> sym(p, all(p'(a, b) == p'(b, a)))(p);
  left_quasi_reflexive : left_quasi_reflexive';
  left_quasi_reflexive_from : sym(p, all(p'(a, b) -> p'(a, a)))(p) -> left_quasi_reflexive'(p);
  left_quasi_reflexive_to : left_quasi_reflexive'(p) -> sym(p, all(p'(a, b) -> p'(a, a)))(p);
  partial_equivalence : partial_equivalence';
  partial_equivalence_from : (commutative'(p) & transitive'(p)) -> partial_equivalence'(p);
  partial_equivalence_to : partial_equivalence'(p) -> (commutative'(p) & transitive'(p));
  partial_equivalence_to_left_quasi_reflexive : partial_equivalence'(p) -> left_quasi_reflexive'(p);
  partial_equivalence_to_quasi_reflexivity : partial_equivalence'(p) -> quasi_reflexive'(p);
  partial_equivalence_to_right_quasi_reflexive : partial_equivalence'(p) -> right_quasi_reflexive'(p);
  quasi_reflexive : quasi_reflexive';
  quasi_reflexive_from : (left_quasi_reflexive'(p) & right_quasi_reflexive'(p)) -> quasi_reflexive'(p);
  quasi_reflexive_to : quasi_reflexive'(p) -> (left_quasi_reflexive'(p) & right_quasi_reflexive'(p));
  reflexive : reflexive';
  reflexive_from : sym(p, all(p'(a, a)))(p) -> reflexive'(p);
  reflexive_prop_eq : true -> reflexive'(prop_eq');
  reflexive_prop_imply : true -> reflexive'(prop_imply');
  reflexive_to : reflexive'(p) -> sym(p, all(p'(a, a)))(p);
  right_quasi_reflexive : right_quasi_reflexive';
  right_quasi_reflexive_from : sym(p, all(p'(a, b) -> p'(b, b)))(p) -> right_quasi_reflexive'(p);
  right_quasi_reflexive_to : right_quasi_reflexive'(p) -> sym(p, all(p'(a, b) -> p'(a, a)))(p);
  transitive : transitive';
  transitive_from : sym(p, all((p'(a, b) & p'(b, c)) => p'(a, c)))(p) -> transitive'(p);
  transitive_prop_and : true -> transitive'(prop_and');
  transitive_prop_imply : true -> transitive'(prop_imply');
  transitive_to : transitive'(p) -> sym(p, all((p'(a, b) & p'(b, c)) => p'(a, c)))(p);
  transitivie_prop_eq : true -> transitive'(prop_eq');
  transitivity_q : true -> transitive'(q');
}
grades {
    congruence_application_strength: {
        1: [
            associative_prop_and,
            associative_prop_eq_excm,
            associative_prop_or,
            commutative_prop_and,
            commutative_prop_eq,
            commutative_prop_or,
            reflexive_prop_eq,
            reflexive_prop_imply,
            transitive_prop_and,
            transitive_prop_imply,
            transitivie_prop_eq,
        ];
    };
}
dependencies {
}
